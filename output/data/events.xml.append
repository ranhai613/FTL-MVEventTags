<FTL>
  <mod:findName name="GIVE_ME_A_BREACH_BEAM" type="event">
    <mod:findLike type="choice">
      <mod:selector hidden="false"/>
      <mod:findLike type="text">
        <mod:selector>Yes please!</mod:selector>
        <mod:setValue>Yes please![INFO][NAME]weapon[/NAME][style[color:00E000]]Gain a weapon(Beam Breach)[[/style]][/INFO]</mod:setValue>
      </mod:findLike>
    </mod:findLike>
  </mod:findName>
  <mod:findName name="STALEMATE_SURRENDER" type="event">
    <mod:findLike type="choice">
      <mod:findLike type="text">
        <mod:selector>Accept their truce.</mod:selector>
        <mod:setValue>Accept their truce.[INFO][NAME]itemModify[/NAME][style[color:00E000]]2≤{≤4[[/style]][/INFO]</mod:setValue>
      </mod:findLike>
    </mod:findLike>
  </mod:findName>
  <mod:findName name="START_BEACON_TUTORIAL" type="event">
    <mod:findLike type="choice">
      <mod:selector hidden="true"/>
      <mod:findLike type="text">
        <mod:selector>Skip the tutorial.</mod:selector>
        <mod:setValue>Skip the tutorial.[INFO][NAME]itemModify[/NAME][style[color:E00000]]{-999[[/style]] [style[color:E00000]]~-999[[/style]][/INFO]</mod:setValue>
      </mod:findLike>
    </mod:findLike>
  </mod:findName>
  <mod:findName name="START_BEACON_TUTORIAL" type="event">
    <mod:findLike type="choice">
      <mod:selector hidden="true"/>
      <mod:findName name="START_BEACON_TUTORIAL_SKIP" type="event">
        <mod:findLike type="choice">
          <mod:selector hidden="true"/>
          <mod:findLike type="text">
            <mod:selector>Yes, I would like to skip the tutorial.</mod:selector>
            <mod:setValue>Yes, I would like to skip the tutorial.[INFO][NAME]itemModify[/NAME][style[color:E00000]]{-999[[/style]] [style[color:E00000]]~-999[[/style]][/INFO]</mod:setValue>
          </mod:findLike>
        </mod:findLike>
      </mod:findName>
    </mod:findLike>
  </mod:findName>
  <mod:findName name="START_BEACON_FAKE" type="event">
    <mod:findLike type="choice">
      <mod:selector hidden="true"/>
      <mod:findLike type="text">
        <mod:selector>Continue...</mod:selector>
        <mod:setValue>Continue...[INFO][NAME]itemModify[/NAME][style[color:E00000]]{-999[[/style]] [style[color:E00000]]~-999[[/style]][/INFO]</mod:setValue>
      </mod:findLike>
    </mod:findLike>
  </mod:findName>
  <mod:findName name="GENERIC_SURRENDER" type="event">
    <mod:findLike type="choice">
      <mod:findLike type="text">
        <mod:selector>Accept their offer.</mod:selector>
        <mod:setValue>Accept their offer.[INFO][NAME]autoReward[/NAME][style[color:00E000]]Reward Stuff(R)[[/style]][/INFO]</mod:setValue>
      </mod:findLike>
    </mod:findLike>
  </mod:findName>
  <mod:findName name="CIVILIAN_SAVE" type="event">
    <mod:findLike type="choice">
      <mod:selector hidden="true"/>
      <mod:findLike type="text">
        <mod:selector>Continue...</mod:selector>
        <mod:setValue>Continue...[INFO]17% [NAME]autoReward[/NAME][style[color:00E000]]Reward ~ Only(M)[[/style]][/INFO][INFO]17% [NAME]autoReward[/NAME][style[color:00E000]]Reward } Only(H)[[/style]][/INFO][INFO]17% [NAME]autoReward[/NAME][style[color:00E000]]Reward { Only(H)[[/style]][/INFO][INFO]17% [NAME]autoReward[/NAME][style[color:00E000]]Reward | Only(H)[[/style]][/INFO][INFO]17% [NAME]damage[/NAME][style[color:00E000]]Repair Hull(5$)[[/style]][/INFO]</mod:setValue>
      </mod:findLike>
    </mod:findLike>
  </mod:findName>
  <mod:findName name="CIVILIAN_GIFT_LIST_MV" type="eventList">
    <mod:findLike type="event">
      <mod:findLike type="choice">
        <mod:findLike type="text">
          <mod:selector>Welcome aboard!</mod:selector>
          <mod:setValue>Welcome aboard![INFO][NAME]crewMember[/NAME][style[color:00E000]]Gain a crew(Random)[[/style]][/INFO]</mod:setValue>
        </mod:findLike>
      </mod:findLike>
    </mod:findLike>
  </mod:findName>
</FTL>
