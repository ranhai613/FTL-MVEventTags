<FTL>
  <mod:findName name="FINISH_BEACON_PIRATE" type="event">
    <mod:findLike type="choice">
      <mod:selector hidden="true"/>
      <mod:findLike type="text">
        <mod:selector>Do something onboard the ship.</mod:selector>
        <mod:setValue>Do something onboard the ship.[INFO][NAME]storageCheck[/NAME][style[color:707070]]Storage Check[[/style]][/INFO]</mod:setValue>
      </mod:findLike>
    </mod:findLike>
  </mod:findName>
  <mod:findName name="BLACKMARKET_DESPERATE_SLUG" type="event">
    <mod:findLike type="choice">
      <mod:findLike type="text">
        <mod:selector>Contact him.</mod:selector>
        <mod:setValue>Contact him.[FightINFO][style[color:FF8A33]]Fight[[/style]](CK=HK: [INFO][NAME]weapon[/NAME][style[color:00E000]]Gain a weapon(Laser Burst 1)[[/style]][/INFO] [INFO][NAME]autoReward[/NAME][style[color:00E000]]Reward ~ Only(M)[[/style]][/INFO])(SR: [INFO][NAME]autoReward[/NAME][style[color:00E000]]Reward Stuff(R)[[/style]][/INFO])[/FightINFO]</mod:setValue>
      </mod:findLike>
    </mod:findLike>
  </mod:findName>
