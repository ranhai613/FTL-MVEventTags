        <mod:selector>Did that Mantis board our ship?</mod:selector>
        <mod:setValue>Did that Mantis board our ship?[INFO][NAME]removeCrew[/NAME][style[color:E00000]]&lt;!&gt;Lose your crew([[/style]][style[color:700000]]clonable[[/style]][style[color:E00000]])[[/style]][/INFO]</mod:setValue>
      </mod:findLike>
    </mod:findLike>
  </mod:findName>
